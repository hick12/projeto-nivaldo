# Copie para .env e preencha. O .env NUNCA vai para o Git.

# ---------------------------------------------------------------------
# Obrigatorias
#
# Em producao estas duas NAO tem valor padrao: se faltarem, a aplicacao
# sobe em modo degradado e responde 503 em toda rota, dizendo o NOME da
# variavel que falta. Fora de producao existe um padrao de
# desenvolvimento, para o `flask run` da maquina local subir sem
# configuracao nenhuma.
# ---------------------------------------------------------------------

# Conexao local. No Railway esta variavel vem da reference ${{Postgres.DATABASE_URL}}
# ou de uma URL explicita apontando para o papel torra_app.
DATABASE_URL=postgresql://torra_app:troque_esta_senha@localhost:5432/torra_terra

# Gere a sua com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-string-longa-e-aleatoria


# ---------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------

# Quem abre o /painel. E-mails separados por virgula, sem espaco
# obrigatorio. Um cliente logado cujo e-mail esteja nesta lista e gestor;
# os demais recebem 403. Vazia (ou ausente) = ninguem e gestor.
ADMIN_EMAILS=gestor@exemplo.com

# Marca este processo como producao. O Railway ja define
# RAILWAY_ENVIRONMENT sozinho, e qualquer uma das duas basta — esta existe
# para funcionar em outro provedor ou para testar o modo de producao local.
# AMBIENTE=producao

FLASK_ENV=development

# Banco dos testes. Sem ela, o pytest usa a DATABASE_URL com sufixo _teste.
# TEST_DATABASE_URL=postgresql://torra_app:troque_esta_senha@localhost:5432/torra_terra_teste
